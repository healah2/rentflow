# Allowed Django hosts (comma-separated; hostnames only, no scheme or path)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,rentflowapi.xulttech.com

# Browser origins permitted to call the API (comma-separated, including scheme)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://rentflow.tecade.top

# Database Configuration (Defaults to SQLite 3)
# To use PostgreSQL in future production, set DATABASE_URL:
